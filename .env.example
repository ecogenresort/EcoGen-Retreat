# Google Apps Script Web App deployment URL (ends in /exec).
# See the setup guide for how to create this. Required for the booking
# and contact forms to work — the app logs a console warning in dev if unset.
VITE_GOOGLE_SCRIPT_URL=

# Supabase project URL and anon (public) key, from Project Settings > API.
# Powers the /admin bookings/leads dashboard and the dual-write from the
# booking/contact forms. Safe to expose client-side — access is enforced by
# Postgres Row Level Security, not by keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
